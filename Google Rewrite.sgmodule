#!name=Google Rewrite
#!author=Acher
#!desc = 谷歌搜索重定向

[URL Rewrite]
# 𝐆𝐨𝐨𝐠𝐥𝐞
^https?://(?:[^/]+\.)?(?:g|google)\.cn(.*)$ https://www.google.com$1 302
# 𝐆𝐢𝐭𝐇𝐮𝐛
^https?://hisuio/(.*)$ https://github.com/Anchen520i/Dynamic/raw/Surge/Rule/$1.list 302
^https?://acher/(.*)$ https://github.com/Anchen520i/Dynamic/raw/Surge/icon/$1.png 302
^https?://dns/China https://raw.githubusercontent.com/Anchen520i/Dynamic/Surge/Rule/China.txt 302

[MITM]
hostname = %APPEND% google.cn, *.google.cn, g.cn, *.g.cn
