#!name=YouTube for Safari
#!author=Acher
#!desc=Safari YouTube 2.0.0：播放请求参数规避视频广告，并清理独立展示广告卡片；不改写播放器广告字段、不阻断媒体、不自动点击跳过。网站参数未公开，失效时关闭此模块。
#!system=mac
#!category=Acher

[Script]
youtube.safari.page = type=http-request,pattern=^https://www\.youtube\.com/watch(?:\?|$),script-path=https://raw.githubusercontent.com/Vaerios/Nyora/refs/heads/Surge/Script/YouTube/YouTube-for-Safari.js,timeout=5
youtube.safari.request = type=http-request,pattern=^https://www\.youtube\.com/youtubei/v1/(?:player|get_watch|next)(?:\?|$),requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/Vaerios/Nyora/refs/heads/Surge/Script/YouTube/YouTube-for-Safari.js,timeout=5
youtube.safari.html = type=http-response,pattern=^https://www\.youtube\.com/(?:$|\?|watch(?:\?|$)|results(?:\?|$)|playlist(?:\?|$)|shorts/|feed/),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/Vaerios/Nyora/refs/heads/Surge/Script/YouTube/YouTube-for-Safari.js,timeout=5
youtube.safari.response = type=http-response,pattern=^https://www\.youtube\.com/youtubei/v1/(?:player|get_watch|next|browse|search)(?:\?|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/Vaerios/Nyora/refs/heads/Surge/Script/YouTube/YouTube-for-Safari.js,timeout=5

[MITM]
hostname = %APPEND% www.youtube.com
